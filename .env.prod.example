# ===== API Configuration =====
# En producción, vacío para que las llamadas vayan al mismo origen
# Nginx proxy pasa /api/ al backend
VITE_API_URL=

# ===== MSW =====
VITE_MSW_ENABLED=false

# ===== App =====
VITE_APP_NAME=Sistema de Alertas Tempranas
VITE_APP_VERSION=1.0.0

# ===== Storage Keys =====
VITE_TOKEN_KEY=access_token
VITE_REFRESH_TOKEN_KEY=refresh_token
VITE_USER_KEY=user
VITE_PERMISOS_KEY=permisos

# ===== Feature Flags =====
VITE_ENABLE_DEBUG=false
VITE_ENABLE_ANALYTICS=false
