# ============================================
# CONFIGURACIÓN DEL FRONTEND - SISTEMA DE ALERTAS TEMPRANAS
# ============================================
# Copia este archivo como .env y completa los valores

# ===== API Configuration =====
VITE_API_URL=http://localhost:8000
VITE_API_TIMEOUT=30000

# ===== MSW (Mock Service Worker) =====
# false = usa backend real, true = usa mocks para desarrollo
VITE_MSW_ENABLED=false

# ===== App Configuration =====
VITE_APP_NAME=Sistema de Alertas Tempranas
VITE_APP_VERSION=1.0.0

# ===== Google Gemini AI (opcional) =====
# VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ===== Storage Keys =====
VITE_TOKEN_KEY=access_token
VITE_REFRESH_TOKEN_KEY=refresh_token
VITE_USER_KEY=user
VITE_PERMISOS_KEY=permisos

# ===== Feature Flags =====
VITE_ENABLE_DEBUG=false
VITE_ENABLE_ANALYTICS=false
